# ============================================================
# Lipa City Colleges — HR & Payroll Database Configuration
# Copy this file to .env and paste your Neon connection string
# ============================================================

# Option 1: Neon Serverless PostgreSQL (for online / cloud database)
# Paste your connection string from Neon Console -> Dashboard -> Connect:
# Example: DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-cool-name-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL=""

# Option 2: Local XAMPP MySQL / MariaDB (used automatically when DATABASE_URL is empty)
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="paywise_payroll"
DB_USER="root"
DB_PASS=""
