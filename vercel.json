{
  "regions": ["sin1"],
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.1",
      "includeFiles": "{login.php,index.html,auth/**,config/**,employee/**,includes/**,pages/**,print/**,vendor/**,uploads/**}"
    }
  },
  "routes": [
    {
      "src": "^/assets/(.*)$",
      "dest": "/assets/$1"
    },
    {
      "src": "^/uploads/(.*)$",
      "dest": "/uploads/$1"
    },
    {
      "src": "^/$",
      "dest": "/api/index.php"
    },
    {
      "src": "^/(.*\\.php)$",
      "dest": "/api/index.php"
    }
  ]
}
